    {
      "name": "Court Availability",
      "item": [
        {
          "name": "Consultar disponibilidad de cancha",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auth_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/courts/:courtId/availability?date=2024-12-25",
              "host": ["{{base_url}}"],
              "path": ["courts", ":courtId", "availability"],
              "query": [
                {
                  "key": "date",
                  "value": "2024-12-25",
                  "description": "Fecha en formato YYYY-MM-DD"
                }
              ],
              "variable": [
                {
                  "key": "courtId",
                  "value": "",
                  "description": "ID de la cancha"
                }
              ]
            },
            "description": "Obtiene los slots de tiempo disponibles para una cancha en una fecha específica.\n\nEl sistema calcula la disponibilidad basándose en:\n1. El horario base semanal (CourtSchedule)\n2. Los bloqueos y excepciones del día (CourtAvailability)\n3. Fusiona automáticamente slots contiguos"
          },
          "response": []
        },
        {
          "name": "Crear excepción de disponibilidad",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
