            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/courts/:courtId/availability-exceptions",
              "host": ["{{base_url}}"],
              "path": ["courts", ":courtId", "availability-exceptions"],
              "variable": [
                {
                  "key": "courtId",
                  "value": "",
                  "description": "ID de la cancha"
                }
              ]
            },
            "description": "Obtiene todas las excepciones de disponibilidad de una cancha"
