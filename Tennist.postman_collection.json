                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cancha Central\",\n  \"surface\": \"CLAY\",\n  \"isIndoor\": false,\n  \"isLighted\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/venues/:venueId/courts",
              "host": ["{{base_url}}"],
              "path": ["venues", ":venueId", "courts"],
              "variable": [
                {
                  "key": "venueId",
                  "value": "",
                  "description": "ID del venue donde se creará la cancha"
                }
              ]
            },
            "description": "Crea una nueva cancha en un venue. El usuario debe ser propietario del venue o ADMIN.\n\nTipos de superficie:\n- HARD: Cancha dura\n- CLAY: Arcilla\n- GRASS: Césped\n- SYNTHETIC: Sintética"
          },
          "response": []
        },
        {
          "name": "Listar canchas de un venue",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auth_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/venues/:venueId/courts",
              "host": ["{{base_url}}"],
              "path": ["venues", ":venueId", "courts"],
              "variable": [
                {
                  "key": "venueId",
                  "value": "",
                  "description": "ID del venue"
                }
              ]
            },
            "description": "Obtiene todas las canchas de un venue específico"
          },
          "response": []
        }
      ],
      "description": "Gestión de canchas de tenis"
    },
