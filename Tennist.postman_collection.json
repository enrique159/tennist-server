{
  "info": {
    "name": "Tennist API",
    "description": "Colección de endpoints para la API de Tennist - Sistema de gestión de tenis",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "tennist-api"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registro de usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@example.com\",\n  \"password\": \"password123\",\n  \"phoneNumber\": \"+1234567890\",\n  \"fullName\": \"Juan Pérez\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/signup",
              "host": ["{{base_url}}"],
              "path": ["auth", "signup"]
            },
            "description": "Crea una nueva cuenta de usuario en el sistema"
          },
          "response": []
        },
        {
          "name": "Inicio de sesión",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set(\"auth_token\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailPhone\": \"usuario@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/signin",
              "host": ["{{base_url}}"],
              "path": ["auth", "signin"]
            },
            "description": "Inicia sesión y obtiene un token JWT. El token se guarda automáticamente en la variable auth_token."
          },
          "response": []
        }
      ],
      "description": "Endpoints de autenticación y gestión de sesiones"
    },
    {
      "name": "Venues",
      "item": [
        {
          "name": "Crear venue público (ADMIN)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auth_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Parque Deportivo Municipal\",\n  \"description\": \"Instalaciones públicas de tenis\",\n  \"address\": \"Av. Reforma 100, Ciudad\",\n  \"lat\": 19.4326,\n  \"lng\": -99.1332,\n  \"type\": \"PUBLIC\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/venues",
              "host": ["{{base_url}}"],
              "path": ["venues"]
            },
            "description": "Crea un venue público. Solo usuarios con rol ADMIN pueden crear venues públicos."
          },
          "response": []
        },
        {
          "name": "Crear venue privado (CLUB_OWNER)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auth_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Club Deportivo Central\",\n  \"description\": \"Club de tenis con instalaciones de primer nivel\",\n  \"address\": \"Av. Principal 123, Ciudad\",\n  \"lat\": 19.4326,\n  \"lng\": -99.1332,\n  \"type\": \"PRIVATE\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/venues",
              "host": ["{{base_url}}"],
              "path": ["venues"]
            },
            "description": "Crea un venue privado. Usuarios con rol CLUB_OWNER o ADMIN pueden crear venues privados."
          },
          "response": []
        },
        {
          "name": "Buscar venues cercanos",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auth_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/venues/nearby?lat=19.4326&lng=-99.1332&radiusKm=10&type=PUBLIC&status=active",
              "host": ["{{base_url}}"],
              "path": ["venues", "nearby"],
              "query": [
                {
                  "key": "lat",
                  "value": "19.4326",
                  "description": "Latitud de tu ubicación (requerido)"
                },
                {
                  "key": "lng",
                  "value": "-99.1332",
                  "description": "Longitud de tu ubicación (requerido)"
                },
                {
                  "key": "radiusKm",
                  "value": "10",
                  "description": "Radio de búsqueda en km (opcional, default: 10, max: 100)"
                },
                {
                  "key": "type",
                  "value": "PUBLIC",
                  "description": "Tipo de venue: PUBLIC o PRIVATE (opcional)"
                },
                {
                  "key": "status",
                  "value": "active",
                  "description": "Estado: active, inactive, deleted (opcional, default: active)"
                }
              ]
            },
            "description": "Busca venues cercanos a tu ubicación con filtros opcionales.\n\nLos resultados incluyen la distancia en km y están ordenados del más cercano al más lejano.\n\nPor defecto solo muestra venues activos."
          },
          "response": []
        },
        {
          "name": "Obtener venue por ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auth_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/venues/:venueId",
              "host": ["{{base_url}}"],
              "path": ["venues", ":venueId"],
              "variable": [
                {
                  "key": "venueId",
                  "value": "",
                  "description": "ID del venue"
                }
              ]
            },
            "description": "Obtiene la información de un venue específico incluyendo sus canchas"
          },
          "response": []
        }
      ],
      "description": "Gestión de venues (lugares deportivos)"
    },
    {
      "name": "Courts",
      "item": [
        {
          "name": "Crear cancha",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
