              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2024-12-25\",\n  \"startTime\": \"10:00\",\n  \"endTime\": \"14:00\",\n  \"type\": \"BLOCKED\",\n  \"reason\": \"Mantenimiento de cancha\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/courts/:courtId/availability-exceptions",
              "host": ["{{base_url}}"],
              "path": ["courts", ":courtId", "availability-exceptions"],
              "variable": [
                {
                  "key": "courtId",
                  "value": "",
                  "description": "ID de la cancha"
                }
              ]
            },
            "description": "Crea una excepción de disponibilidad (bloqueo o disponibilidad especial).\n\nTipos:\n- BLOCKED: Bloquea el horario\n- AVAILABLE: Agrega disponibilidad especial"
          },
          "response": []
        },
        {
          "name": "Listar excepciones de disponibilidad",
